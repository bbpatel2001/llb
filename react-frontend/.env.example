# Leave empty to use the Vite proxy (frontend :6001 -> backend :6000)
VITE_API_URL=
# Docker Compose uses the backend service name; local development uses localhost.
VITE_API_PROXY_TARGET=http://localhost:6000
VITE_APP_NAME=LLB Knowledge Platform
VITE_APP_ENV=development
# Cloudflare Turnstile public site key for login, registration, and password reset.
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key
