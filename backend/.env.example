# Server Configuration
PORT=6000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/llb_platform
# For MongoDB Atlas use:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/llb_platform

# Authentication
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# CORS
CORS_ORIGIN=http://localhost:6001

# Generated Content
CONTENT_DIR=../generated


# AI Question Extraction (choose one)
# Option 1: Groq API (free, recommended, fast)
# Sign up: https://console.groq.com
# GROQ_API_KEY=gsk_your_api_key_here

# Option 2: Anthropic Claude (paid, or free credits)
# ANTHROPIC_API_KEY=sk_your_key_here

# Option 3: Local Ollama (completely free, privacy)
# Install: https://ollama.ai
# OLLAMA_URL=http://localhost:11434

# Authentication
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d
# Cloudflare Turnstile secret; required in production to protect auth forms.
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
